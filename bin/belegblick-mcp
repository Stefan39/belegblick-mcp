#!/usr/bin/env php
<?php

declare(strict_types=1);

use Jacomeit\Belegblick\Config\Configuration;
use Jacomeit\Belegblick\Exception\MissingApiKeyException;
use Jacomeit\Belegblick\ServerFactory;
use Mcp\Server\Transport\StdioTransport;

$autoloaders = [__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'];
foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;
        break;
    }
}

// STDOUT carries the MCP protocol; anything else must go to STDERR.
try {
    $configuration = Configuration::fromEnvironment(getenv());
} catch (MissingApiKeyException $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);
    exit(1);
}

$exitCode = ServerFactory::create($configuration)->run(new StdioTransport());

exit(is_int($exitCode) ? $exitCode : 0);
